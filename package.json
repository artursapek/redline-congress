{
  "name": "redlinecongress",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --noEmit",
    "deploy": "WRANGLER_CONFIG=wrangler.production.jsonc npm run build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply redlinecongress-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply redlinecongress-db --remote --config wrangler.production.jsonc"
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "hono": "^4.7.10",
    "lucide-react": "^0.511.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.1",
    "revise": "^4.6.2",
    "y-protocols": "^1.0.6",
    "yjs": "^13.6.27"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.4.2",
    "@cloudflare/workers-types": "^5.20261123.1",
    "@types/react": "^19.1.5",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "^4.5.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.1.4",
    "wrangler": "^4.16.1"
  }
}
